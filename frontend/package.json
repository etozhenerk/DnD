{
  "name": "dnd-campaign-atlas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --mode github-pages",
    "balance:penisuela": "node scripts/simulate-penisuela-balance.mjs",
    "validate:penisuela-playable": "node scripts/validate-penisuela-playable-bridge.mjs",
    "test:final-boss": "node scripts/test-final-boss-rules.mjs",
    "test:npc": "node --experimental-strip-types scripts/test-npc-behavior.ts",
    "test:penisuela": "npm run validate:penisuela-playable && npm run test:penisuela-navigation && node scripts/test-penisuela-runtime.mjs",
    "test:penisuela-navigation": "node scripts/test-penisuela-navigation-regressions.mjs",
    "test:prop-room": "node --experimental-strip-types scripts/test-prop-room-mechanics.ts",
    "test:pussy-audience": "node scripts/run-typescript-test.mjs scripts/test-pussy-audience-mechanics.ts",
    "test:session": "node scripts/run-typescript-test.mjs scripts/test-session-rules.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "test:regression": "node scripts/test-penisuela-regression.mjs"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
